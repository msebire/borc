root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.{ps1,psm1,psd1}]
charset = utf-8-bom

# Piped through irm | iex, where a BOM breaks the parsing; kept ASCII only.
[/install.ps1]
charset = utf-8
